# --- API keys ---
GROQ_API_KEY=your-groq-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Per-agent provider selection ---
# Each value must be "groq" or "anthropic".
# Copywriter defaults to Groq (fast draft generation).
# Sweeper and Analytics default to Anthropic (accuracy-sensitive).
COPYWRITER_PROVIDER=groq
SWEEPER_PROVIDER=anthropic
ANALYTICS_PROVIDER=anthropic

# --- Per-agent model overrides (optional) ---
COPYWRITER_GROQ_MODEL=llama-3.3-70b-versatile
COPYWRITER_ANTHROPIC_MODEL=claude-opus-5

SWEEPER_GROQ_MODEL=llama-3.3-70b-versatile
SWEEPER_ANTHROPIC_MODEL=claude-opus-5

ANALYTICS_GROQ_MODEL=llama-3.3-70b-versatile
ANALYTICS_ANTHROPIC_MODEL=claude-opus-5

# --- Database ---
DATABASE_PATH=./andsons.db

# --- Optional: live BigQuery for the Analytics chat ---
# Leave BIGQUERY_PROJECT_ID empty (default) to always use the local mock
# database above. If set, the analytics agent tries a real BigQuery
# connection first and falls back to the mock database automatically if it
# isn't reachable (no credentials, no IAM permission, etc.).
# The real ORA warehouse is a shared multi-brand/multi-country project - set
# BIGQUERY_TABLES (comma-separated) to restrict which tables the agent can
# even see, so it can't wander into another brand's data or a stale
# snapshot table. Also needs GOOGLE_APPLICATION_CREDENTIALS pointing at a
# service account key file (never commit that file - see README).
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET=
BIGQUERY_TABLES=

# --- Optional: Slack slash commands (office testing) ---
# From your Slack app's "Basic Information" page -> App Credentials ->
# Signing Secret. Required to verify incoming requests actually came from
# Slack; without it, /slack/* endpoints reject every request.
SLACK_SIGNING_SECRET=

# --- Optional: Slack @-mention bots (office testing) ---
# Two separate Slack apps (each with its own name/icon), for @-mentioning
# instead of slash commands. Each needs its own Signing Secret (Basic
# Information -> App Credentials) and Bot Token (OAuth & Permissions ->
# Bot User OAuth Token, after adding app_mentions:read + chat:write scopes
# and installing the app) - replies go through chat.postMessage, since
# events have no response_url like slash commands do.
SLACK_EMAIL_SIGNING_SECRET=
SLACK_EMAIL_BOT_TOKEN=
SLACK_ANALYTICS_SIGNING_SECRET=
SLACK_ANALYTICS_BOT_TOKEN=

# Only needed if deploying somewhere other than Render (which sets
# RENDER_EXTERNAL_URL automatically) - Slack's image blocks are fetched
# server-side, so hero image URLs need to be absolute, not relative.
PUBLIC_BASE_URL=

# --- Flask ---
FLASK_PORT=5001
