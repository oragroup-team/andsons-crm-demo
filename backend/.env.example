# --- API keys ---
GROQ_API_KEY=your-groq-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Per-agent provider selection ---
# Each value must be "groq" or "anthropic".
# Copywriter defaults to Groq (fast draft generation).
# Sweeper and Analytics default to Anthropic (accuracy-sensitive).
COPYWRITER_PROVIDER=groq
SWEEPER_PROVIDER=anthropic
ANALYTICS_PROVIDER=anthropic

# --- Per-agent model overrides (optional) ---
COPYWRITER_GROQ_MODEL=llama-3.3-70b-versatile
COPYWRITER_ANTHROPIC_MODEL=claude-opus-5

SWEEPER_GROQ_MODEL=llama-3.3-70b-versatile
SWEEPER_ANTHROPIC_MODEL=claude-opus-5

ANALYTICS_GROQ_MODEL=llama-3.3-70b-versatile
ANALYTICS_ANTHROPIC_MODEL=claude-opus-5

# --- Live BigQuery for the Analytics chat (required - no mock fallback) ---
# The real ORA warehouse is a shared multi-brand/multi-country project - set
# BIGQUERY_TABLES (comma-separated) to restrict which tables the agent can
# even see, so it can't wander into another brand's data or a stale
# snapshot table. Also needs GOOGLE_APPLICATION_CREDENTIALS pointing at a
# service account key file (never commit that file - see README).
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET=
BIGQUERY_TABLES=

# --- Optional: Slack slash commands (office testing) ---
# From your Slack app's "Basic Information" page -> App Credentials ->
# Signing Secret. Required to verify incoming requests actually came from
# Slack; without it, /slack/* endpoints reject every request.
SLACK_SIGNING_SECRET=

# --- Optional: Slack @-mention bots (office testing) ---
# Two separate Slack apps (each with its own name/icon), for @-mentioning
# instead of slash commands. Each needs its own Signing Secret (Basic
# Information -> App Credentials) and Bot Token (OAuth & Permissions ->
# Bot User OAuth Token, after adding app_mentions:read + chat:write +
# files:read scopes and installing the app) - replies go through
# chat.postMessage, since events have no response_url like slash commands
# do; files:read lets the bot download a CSV/Excel file someone attaches.
SLACK_EMAIL_SIGNING_SECRET=
SLACK_EMAIL_BOT_TOKEN=
SLACK_ANALYTICS_SIGNING_SECRET=
SLACK_ANALYTICS_BOT_TOKEN=

# --- Optional: MoEngage (real campaign/engagement data for insight-driven
# emails - see README "MoEngage integration"). Data API ID/Key come from the
# MoEngage dashboard: Settings -> Account -> APIs. Without these, an
# insight-driven email ("OTC sales are down, write something to fix it")
# still works from BigQuery sales data alone, just without MoEngage's
# campaign-engagement context. Every chart on every workspace dashboard is
# pulled automatically (moengage_client.get_all_chart_snapshots) - no
# per-chart config needed.
MOENGAGE_WORKSPACE_ID=
MOENGAGE_DATA_API_KEY=
# Data center from your dashboard URL (dashboard-0X.moengage.com -> "0X").
MOENGAGE_DC=

# Required once deployed (Cloud Run doesn't auto-inject an env var pointing
# at its own URL, unlike some PaaS hosts) - Slack's image blocks are fetched
# server-side, so hero image URLs need to be absolute, not relative. Set to
# the real Cloud Run service URL - see README "Deploying to Google Cloud".
# Not needed for purely local runs.
PUBLIC_BASE_URL=

# Firestore project for the @-mention bots' session storage (email feedback
# threads, analytics conversation history - see backend/session_store.py).
# Only needed if GOOGLE_APPLICATION_CREDENTIALS points at a service account
# whose OWN project differs from the project your Firestore database is in
# (true here: the BigQuery service account "lives" in ora-bigquery, but
# Firestore is in this app's own Cloud Run project) - Application Default
# Credentials would otherwise infer the wrong project from the key file.
FIRESTORE_PROJECT_ID=

# --- Flask ---
FLASK_PORT=5001
