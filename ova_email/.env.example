# --- API keys (same keys the andSons backend uses - reuse them, or issue
# separate ones if you'd rather keep the two apps' usage/billing distinct) ---
GROQ_API_KEY=your-groq-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Per-agent provider selection ---
# Each value must be "groq" or "anthropic". Claude (Sonnet 5) is the
# primary engine for every agent - Groq is wired in as an automatic
# fallback (llm_provider.py's _anthropic_available() health check), not
# something you configure separately here. Sonnet 5, not Opus 5, is
# deliberate: Opus 5 as the default burned a real ~$100 in credits during
# testing before this was fixed - see llm_provider.py's own DEFAULT_MODELS
# comment.
COPYWRITER_PROVIDER=anthropic
SWEEPER_PROVIDER=anthropic
HEAD_OF_CRM_PROVIDER=anthropic
CREATIVE_DIRECTOR_PROVIDER=anthropic
VISUAL_QA_PROVIDER=anthropic

# --- Per-agent model overrides (optional) ---
COPYWRITER_GROQ_MODEL=openai/gpt-oss-120b
COPYWRITER_ANTHROPIC_MODEL=claude-sonnet-5
SWEEPER_ANTHROPIC_MODEL=claude-sonnet-5
HEAD_OF_CRM_ANTHROPIC_MODEL=claude-sonnet-5
CREATIVE_DIRECTOR_ANTHROPIC_MODEL=claude-sonnet-5
VISUAL_QA_ANTHROPIC_MODEL=claude-sonnet-5

# --- Slack app for @OvaEmail (required) ---
# From your Slack app's Basic Information -> App Credentials -> Signing
# Secret, and OAuth & Permissions -> Bot User OAuth Token (starts xoxb-),
# after adding app_mentions:read + chat:write + files:read + files:write
# scopes and installing the app. See README.md's Slack setup section.
SLACK_OVA_EMAIL_SIGNING_SECRET=
SLACK_OVA_EMAIL_BOT_TOKEN=

# --- Firestore session storage (required for thread memory) ---
# Same Firestore project the andSons backend uses is fine - this app's own
# collections are all prefixed "ova_" (see session_store.py) so the two
# apps' data never mixes. Only needed if GOOGLE_APPLICATION_CREDENTIALS
# points at a service account whose OWN project differs from the project
# your Firestore database is in - see the andSons backend's README for the
# one-time `gcloud firestore databases create` / IAM setup, already done if
# you're pointing this at the same project.
FIRESTORE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Flask ---
FLASK_PORT=5002
